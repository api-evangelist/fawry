          "id": "7052bb96-016d-4628-bfb7-669b499ca6f9",
          "name": "Refund a Paid Order",
          "request": {
            "name": "Refund a Paid Order",
            "description": {
              "content": "Refund all or part of a previously paid FawryPay order. The\n`refundAmount` must not exceed the original payment amount and the\norder must be in a refundable status.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ECommerceWeb",
                "Fawry",
                "payments",
                "refund"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantCode\": \"<string>\",\n  \"referenceNumber\": \"<string>\",\n  \"refundAmount\": \"<float>\",\n  \"signature\": \"<string>\",\n  \"reason\": \"<string>\"\n}",
