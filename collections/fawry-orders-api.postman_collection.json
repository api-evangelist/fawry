                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"type\": \"ChargeResponse\",\n  \"referenceNumber\": \"string\",\n  \"merchantRefNumber\": \"string\",\n  \"orderAmount\": 4931.649021249254,\n  \"paymentAmount\": 7308.617206571721,\n  \"fawryFees\": 9474.208420066912,\n  \"paymentMethod\": \"string\",\n  \"orderStatus\": \"string\",\n  \"paymentTime\": 506,\n  \"customerMobile\": \"string\",\n  \"customerMail\": \"string\",\n  \"customerProfileId\": \"string\",\n  \"signature\": \"string\",\n  \"statusCode\": 9097,\n  \"statusDescription\": \"string\"\n}",
