        {
          "id": "c7fb6219-c203-4e3a-b3a7-b226be3343d9",
          "name": "Get Payment Status",
          "request": {
            "name": "Get Payment Status",
            "description": {
              "content": "Pull the current status of a FawryPay order by merchant code and\nmerchant reference number. Equivalent payload is also delivered via\nthe server notification v2 push webhook configured per merchant.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ECommerceWeb",
                "Fawry",
                "payments",
                "status",
                "v2"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "merchantCode",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "merchantRefNumber",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "signature",
                  "value": "<string>",
                  "description": "(Required) SHA-256 hash of `merchantCode + merchantRefNumber + secureKey`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "bca8e87f-abb2-4922-8a52-2b7a0e3cc77e",
              "name": "Current order status.",
              "originalRequest": {
                "url": {
                  "path": [
                    "ECommerceWeb",
                    "Fawry",
                    "payments",
                    "status",
                    "v2"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
